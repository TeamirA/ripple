# Runtime
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# PostgreSQL (local or Neon).
# On Neon/Vercel use the pooled ("-pooler") string and append &pgbouncer=true&connect_timeout=15
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ripple_dev
# Direct (non-pooled) connection used by Prisma migrations. Same as DATABASE_URL locally.
# The Neon integration on Vercel sets this variable automatically.
DATABASE_URL_UNPOOLED=postgresql://postgres:postgres@localhost:5432/ripple_dev

# Auth: generate with `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_SECRET=replace-with-a-long-random-string-of-at-least-32-chars
JWT_EXPIRES_IN_DAYS=7

# Comma-separated list of extra origins allowed to call the API (same-origin is always allowed)
CORS_ORIGINS=

# Cloudinary (optional: without it, uploads are disabled and initials avatars are used)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Username of the seeded account used by "Try the demo account"
DEMO_USERNAME=demo
